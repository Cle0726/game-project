# ===== 数据库 =====
ENVIRONMENT=development
DATABASE_URL=sqlite:///./game_data.db

# ===== DeepSeek AI =====
DEEPSEEK_API_KEY=在这里填入你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
